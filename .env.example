# Web waitlist
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Vercel currently uses RESEND_API; either variable is accepted by the app.
RESEND_API=
RESEND_FROM_EMAIL="Keegan at Bram <keegan@trybram.app>"
WAITLIST_NOTIFY_EMAIL=

# iOS app config. The publishable key is safe for client apps; never use the
# Supabase service-role key in iOS.
BRAM_IOS_SUPABASE_URL=https://njotbjmpcostgktjjihv.supabase.co
BRAM_IOS_SUPABASE_PUBLISHABLE_KEY=
BRAM_IOS_AUTH_REDIRECT_SCHEME=app.trybram.Bram

# Public site
NEXT_PUBLIC_SITE_URL=https://trybram.app

# Server-side AI. Do not prefix these with NEXT_PUBLIC.
BRAM_AI_ENABLED=false
OPENAI_API_KEY=
BRAM_AI_PSEUDONYM_SALT=
# Temporary server-side route token until Supabase Auth protects AI endpoints.
BRAM_AI_ROUTE_TOKEN=
BRAM_AI_FAST_MODEL=gpt-5.4-mini
BRAM_AI_STRONG_MODEL=gpt-5.4
BRAM_AI_PREMIUM_MODEL=gpt-5.5
BRAM_AI_MAX_NOTE_CHARS=6000
BRAM_AI_REQUEST_TIMEOUT_MS=15000
BRAM_AI_DAILY_USER_REQUEST_LIMIT=48
BRAM_AI_MONTHLY_ACTIVE_USER_BUDGET_CENTS=40
